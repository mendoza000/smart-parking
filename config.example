# USB serial. Prefer a stable /dev/serial/by-id/... path when available.
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD_RATE=9600

# Local-only bridge by default. Use 0.0.0.0 only on a trusted LAN.
WS_HOST=127.0.0.1
WS_PORT=8080

# Values exposed to the browser. Restart Astro after changing them.
# For LAN clients, replace localhost with the bridge computer's LAN IP.
PUBLIC_WS_URL=ws://localhost:8080
PUBLIC_DEMO_MODE=false
